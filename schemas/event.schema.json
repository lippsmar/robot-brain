{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event/1.0",
  "title": "Event-Log-Eintrag",
  "type": "object",
  "required": ["id", "seq", "ts", "source", "type", "schema"],
  "properties": {
    "id": {"type": "string"},
    "seq": {"type": "integer", "minimum": 0},
    "ts": {"type": "string", "format": "date-time"},
    "source": {"type": "string"},
    "device_id": {"type": "string"},
    "type": {"enum": ["sensor.reading", "device.discovered", "device.command", "device.state", "agent.action", "agent.decision", "comm.sms", "comm.mail", "vision.capture", "system.health", "safety.alert", "error"]},
    "intent": {"type": "string"},
    "payload": {"type": "object"},
    "result": {"type": "string"},
    "latency_ms": {"type": "number", "minimum": 0},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "pii": {"type": "boolean"},
    "schema": {"const": "event/1.0"}
  }
}
